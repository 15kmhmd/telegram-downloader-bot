from aiogram import Router
from aiogram.types import Message, FSInputFile
from services.downloader import download_video
import os

router = Router()

SUPPORTED = (
    "tiktok.com",
    "vm.tiktok.com",
    "instagram.com",
    "facebook.com",
    "fb.watch",
    "youtube.com",
    "youtu.be",
    "x.com",
    "twitter.com",
)

@router.message()
async def download_handler(message: Message):

    if not message.text:
        return

    url = message.text.strip()

    if not any(site in url for site in SUPPORTED):
        return

    status = await message.answer(
        "🔎 <b>يبحث لك أبو جنات عن الفيديو...</b>\n\n"
        "⏳ الرجاء الانتظار."
    )

    try:
        file_path = download_video(url)

        await status.edit_text(
            "✅ <b>عثر لك أبو جنات على الفيديو.</b>\n"
            "📤 جاري الإرسال..."
        )

        video = FSInputFile(file_path)

        await message.answer_video(
            video,
            caption="👨‍💻 Developed by Abu Janat"
        )

        os.remove(file_path)

    except Exception:

        await status.edit_text(
            "❌ تعذر تحميل الفيديو.\n\n"
            "يرجى التأكد من أن الرابط صحيح."
        )
